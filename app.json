{
  "expo": {
    "name": "Balance",
    "slug": "BalanceApp",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "balanceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "supportsRtl": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/appstore.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.usman_2901.BalanceAppV2",
      "targetSdkVersion": 35,
      "minSdkVersion": 26,
      "compileSdkVersion": 35,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "category": "FOOD_AND_DRINK",
    "web": {
      "output": "static",
      "favicon": "./assets/images/appstore.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/appstore.png",
          "color": "#344225",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/balance-text.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAD979",
          "dark": {
            "backgroundColor": "#FAD979"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5409bfdd-81b7-4d56-95cd-d90adfea19dd"
      }
    }
  }
}
